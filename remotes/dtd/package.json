{
  "name": "@cf-mfe/dtd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "deploy:qa": "pnpm build && wrangler deploy --env qa --tag \"${VITE_APP_VERSION:?set VITE_APP_VERSION (e.g. VITE_APP_VERSION=v1.2.3)}\"",
    "deploy:prod": "pnpm build && wrangler deploy --env prod --tag \"${VITE_APP_VERSION:?set VITE_APP_VERSION (e.g. VITE_APP_VERSION=v1.2.3)}\"",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cf-mfe/ui": "workspace:*",
    "@fortawesome/react-fontawesome": "catalog:",
    "@fortawesome/free-solid-svg-icons": "catalog:",
    "@fortawesome/free-regular-svg-icons": "catalog:",
    "@fortawesome/fontawesome-svg-core": "catalog:",
    "@alcumus/design-tokens": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}