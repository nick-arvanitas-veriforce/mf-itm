{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mf-itm-host",
	"main": "worker/index.ts",
	"compatibility_date": "2026-06-16",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/em/*",
			"/dtd/*",
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": true,
	"services": [
		{
			"binding": "EM",
			"service": "mf-itm-em"
		},
		{
			"binding": "DTD",
			"service": "mf-itm-dtd"
		}
	],
	// Host uses @cloudflare/vite-plugin, which selects the env at BUILD time via
	// CLOUDFLARE_ENV (not `wrangler deploy --env`). See package.json deploy:* scripts.
	"env": {
		"qa": {
			// Add a `routes` block with your own custom domain once you have one;
			// without it the Worker is served on *.workers.dev.
			"services": [
				{
					"binding": "EM",
					"service": "mf-itm-em-qa"
				},
				{
					"binding": "DTD",
					"service": "mf-itm-dtd-qa"
				}
			]
		},
		"prod": {
			"services": [
				{
					"binding": "EM",
					"service": "mf-itm-em-prod"
				},
				{
					"binding": "DTD",
					"service": "mf-itm-dtd-prod"
				}
			]
		}
	}
}
